# =============================================================================
# PCO Prime Sync — environment variables (placeholders only, never real values)
# =============================================================================
# Copy this file to `.env` and fill in your own values:
#
#   cp .env.example .env
#   chmod 600 .env
#
# `.env` is git-ignored. Credentials are NEVER stored in SQLite or the browser
# bundle. You can also keep the PCO secret in the macOS Keychain instead of
# `.env` (see docs/SETUP.md).

# --- Server ---------------------------------------------------------------
# Local port for the API + dashboard. Bound to 127.0.0.1 only.
PORT=5178
# Set to "0.0.0.0" only if you deliberately want LAN access. Default is loopback.
HOST=127.0.0.1
# SQLite database file path (relative to the project root by default).
DATABASE_PATH=data/pco-prime-sync.sqlite

# --- Planning Center ------------------------------------------------------
# Create a Personal Access Token at https://api.planningcenteronline.com/oauth/applications
# Use the "Application ID" as the username and "Secret" as the password.
# You can leave both blank and paste the token in the dashboard instead
# (Settings → Planning Center credentials → Test connection → Save and connect);
# the app then writes these two lines here itself.
PCO_APP_ID=your-planning-center-application-id
PCO_SECRET=your-planning-center-secret

# Optional: read the secret from the macOS Keychain instead of .env.
# Create it once with:
#   security add-generic-password -a "$USER" -s pco-prime-sync -w '<secret>'
# Then set PCO_SECRET_KEYCHAIN_SERVICE=pco-prime-sync
PCO_SECRET_KEYCHAIN_SERVICE=
PCO_SECRET_KEYCHAIN_ACCOUNT=

# --- Loop Community Prime -------------------------------------------------
# Base URL of the Loop Community Prime web app used by browser automation.
PRIME_BASE_URL=https://loopcommunity.com
# Optional: the page the manual login window opens. Leave this empty to start at
# the Prime app, which asks WorshipTools (Loop Community's shared sign-in) for
# the form itself. Opening https://auth.worshiptools.com/login directly returns
# a 302 to WorshipTools' corporate home without a form, so the app falls back to
# the Prime app and says that it did.
PRIME_LOGIN_URL=

# Persistent Chromium profile directory. Contains session cookies:
# treat it like a password and never commit or sync it.
PRIME_PROFILE_DIR=profiles/prime

# Run Chromium headless. Keep "false" (visible) while validating the automation.
PRIME_HEADLESS=false

# Milliseconds to wait for the manually logged-in UI before giving up.
PRIME_LOGIN_TIMEOUT_MS=300000

# Default per-action timeout for Playwright operations.
PRIME_ACTION_TIMEOUT_MS=20000

# --- Scheduler ------------------------------------------------------------
# Timezone used by the daily job (handles DST via Intl/launchd).
TZ=America/New_York
SYNC_TIMEZONE=America/New_York
